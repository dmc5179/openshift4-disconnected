variant: openshift
version: 4.21.0 # Match your OpenShift version
metadata:
  name: 99-worker-disable-nouveau
  labels:
    machineconfiguration.openshift.io/role: worker
openshift:
  kernel_arguments:
    - rd.driver.blacklist=nouveau
    - nouveau.modeset=0
